---
// Shared page shell for the Aliya Pet site: Base meta + Nav + Footer + the
// motion/sibling scripts every page needs.

import Base from './Base.astro';
import Nav from '../../../src/components/Nav.astro';
import Footer from '../../../src/components/Footer.astro';
import { pet, navLinks, isActiveNav } from '../data/pet';
import { site, links as siteLinks } from '../../../src/data/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = pet.title, description = pet.description, noindex = false } = Astro.props;
const nav = navLinks.map((l) => ({ ...l, active: isActiveNav(l.href, Astro.url.pathname) }));
---

<Base {title} {description} {noindex}>
  <Nav
    brandHref="https://www.liminalselves.top/"
    brandSibling="www"
    brandAria="返回阈界人格官网"
    links={nav}
    cta={{ label: '下载', href: '/download/' }}
    paged
  />
  <main id="main">
    <slot />
  </main>
  <Footer
    brandHref="https://www.liminalselves.top/"
    brandSibling="www"
    brandAria="返回阈界人格官网"
    cols={[
      {
        heading: '本站',
        links: navLinks.filter((l) => l.href !== '/').map((l) => ({ label: l.label, href: l.href })),
      },
      {
        heading: '项目',
        links: [
          { label: '阈界人格官网', href: site.url, sibling: 'www' },
          { label: 'Aliya Pet 仓库', href: pet.repo },
        ],
      },
      {
        heading: '帮助',
        links: [
          { label: '使用文档', href: siteLinks.docs },
          { label: '社区规范', href: siteLinks.rules },
        ],
      },
      {
        heading: '联系',
        links: [
          { label: `Q 群 ${site.qqGroup}` },
          { label: site.email, href: `mailto:${site.email}` },
        ],
      },
    ]}
  />
</Base>

<script>
  import '../../../src/scripts/motion';
  import { applySiblingLinks } from '../../../src/scripts/sibling';
  applySiblingLinks();
</script>

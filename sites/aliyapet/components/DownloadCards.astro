---
// Download cards. The build renders the three packages in a neutral grid; scripts/download.ts
// then reads the visitor's device and either moves the matching card to the front as the
// featured「推荐」card, or shows the「暂不支持」card there for systems without a build.
// Size, file URL and download counts are filled from /api/latest.
import { platforms } from '../data/pet';
---

<section class="cards light" aria-label="安装包">
  <div class="wrap">
    <ul class="cards__list" data-cards>
      <li class="card card--featured card--none" data-unsupported hidden>
        <h2 class="card__name serif">当前设备暂不支持</h2>
        <p class="card__note">
          Aliya Pet 目前提供 Windows 与 Android 版本，暂不支持 <span data-device-name>当前系统</span>。可以在 Windows 电脑或 Android 手机上打开本页下载。
        </p>
      </li>
      {platforms.map((p, i) => (
        <li class="card" data-card={p.key} data-reveal style={`--d:${i}`}>
          <div class="card__main">
            <div class="card__head">
              <h2 class="card__name serif">{p.title}</h2>
              <span class="card__rec" hidden>推荐</span>
            </div>
            <p class="card__note">{p.note}</p>
            {p.tip && <p class="card__tip">{p.tip}</p>}
          </div>
          <div class="card__side">
            <p class="card__meta">
              大小 <span data-size>—</span><span data-count hidden> · 已下载 <span data-count-num></span> 次</span>
            </p>
            <a class="btn btn--dark card__btn" data-download href={`/download/${p.key}`}>
              <span>{p.label}</span>
            </a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cards {
    padding: clamp(48px, 7vw, 96px) 0 clamp(96px, 13vw, 168px);
  }

  .cards__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  /* Supported device: the featured card takes the first row, the other two share the second. */
  .cards__list[data-mode='pick'] { grid-template-columns: repeat(2, minmax(0, 1fr)); }

  .card {
    display: flex;
    flex-direction: column;
    padding: 32px 28px 28px;
    background: #fff;
    border: 1px solid var(--line-light);
  }
  .card[hidden] { display: none; }
  .card__side { display: flex; flex-direction: column; margin-top: auto; }
  .card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .card__name { font-size: 22px; letter-spacing: 0.08em; }
  .card__rec {
    flex: none;
    padding: 3px 12px;
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--paper);
    background: var(--ink);
    border-radius: 999px;
  }
  .card__rec[hidden] { display: none; }
  .card__note { margin-top: 10px; font-size: 13px; color: #8a8780; }
  .card__tip { margin-top: 14px; font-size: 12px; line-height: 1.8; color: #8a8780; }
  .card__meta { margin-top: 24px; font-size: 13px; color: #4f4d48; }
  .card__btn { margin-top: 18px; width: 100%; height: 48px; }

  /* Featured: the first card, dark and spanning the whole row. */
  .card--featured {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 420px);
    gap: 28px clamp(32px, 6vw, 88px);
    align-items: center;
    padding: clamp(32px, 4vw, 48px);
    color: var(--paper);
    background: linear-gradient(135deg, var(--ink), var(--ink-3));
    border-color: var(--ink);
  }
  .card--featured .card__name { font-size: clamp(26px, 3vw, 34px); }
  .card--featured .card__rec { color: var(--ink); background: var(--paper); }
  .card--featured .card__note { margin-top: 14px; font-size: 14px; color: rgba(244, 241, 236, 0.66); }
  .card--featured .card__tip { color: rgba(244, 241, 236, 0.5); }
  .card--featured .card__side { margin-top: 0; }
  .card--featured .card__meta { margin-top: 0; color: rgba(244, 241, 236, 0.72); }
  .card--featured .card__btn { height: 52px; background: var(--paper); color: var(--ink); border-color: var(--paper); }
  .card--featured .card__btn::before { background: var(--ink-3); }
  .card--featured .card__btn:hover { color: var(--paper); }

  .card--none { display: block; }
  .card--none .card__note { max-width: 680px; line-height: 2; }

  @media (max-width: 960px) {
    .cards__list,
    .cards__list[data-mode='pick'] { grid-template-columns: 1fr; max-width: 640px; }
    .card--featured { grid-template-columns: 1fr; }
  }
</style>

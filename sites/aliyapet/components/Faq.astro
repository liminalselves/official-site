---
import { faqs, platforms, pet } from '../data/pet';
---

<section id="faq" class="faq" aria-labelledby="faq-title">
  <div class="wrap">
    <span class="eyebrow" data-reveal>FAQ · 常见问题</span>
    <h2 id="faq-title" class="section-title" data-reveal style="--d:1">常见问题</h2>

    <ul class="faq__list">
      {faqs.map((f, i) => (
        <li class="qa" data-reveal style={`--d:${i}`}>
          <h3 class="qa__q serif">{f.q}</h3>
          <p class="qa__a">{f.a}</p>
        </li>
      ))}
    </ul>

    <div class="sums" data-reveal>
      <h3 class="sums__title">安装包校验（SHA-256）</h3>
      <ul class="sums__list">
        {platforms.map((p) => (
          <li class="sum" data-checksum={p.key}>
            <span class="sum__label">{p.short}</span>
            <span class="sum__meta">
              <span class="sum__file" data-file>—</span>
              <code class="sum__hash" data-sha>—</code>
            </span>
            <button class="sum__copy" type="button" data-copy hidden>
              <span data-copy-label>复制</span>
            </button>
          </li>
        ))}
      </ul>
      <p class="sums__note">
        校验值来自同源的版本接口；仓库与发布记录见
        <a href={pet.repo} target="_blank" rel="noopener">GitHub</a>。
      </p>
    </div>
  </div>
</section>

<style>
  .faq {
    padding: clamp(96px, 13vw, 168px) 0;
    background: linear-gradient(to bottom, var(--ink-2), var(--ink));
  }

  .faq__list {
    max-width: 860px;
    margin-top: clamp(40px, 5vw, 64px);
    border-top: 1px solid var(--line-dark);
  }
  .qa {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 24px;
    padding: 30px 0;
    border-bottom: 1px solid var(--line-dark);
  }
  .qa__q { font-size: 17px; letter-spacing: 0.06em; line-height: 1.8; }
  .qa__a { font-size: 14px; line-height: 2; color: rgba(244, 241, 236, 0.68); }

  .sums { margin-top: clamp(56px, 8vw, 96px); }
  .sums__title {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 20px;
    letter-spacing: 0.08em;
  }
  .sums__list { margin-top: 24px; border-top: 1px solid var(--line-dark); }
  .sum {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line-dark);
    flex-wrap: wrap;
  }
  .sum__label { font-size: 14px; letter-spacing: 0.08em; min-width: 88px; }
  .sum__meta { display: flex; flex-direction: column; gap: 4px; min-width: 0; flex: 1; }
  .sum__file { font-size: 12px; color: var(--graphite); word-break: break-all; }
  .sum__hash {
    font-family: Consolas, 'Courier New', monospace;
    font-size: 12px;
    color: var(--silver);
    word-break: break-all;
  }
  .sum__copy {
    padding: 6px 14px;
    font: inherit;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--paper);
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 999px;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.3s, color 0.3s;
  }
  .sum__copy:hover { background: var(--paper); color: var(--ink); }
  .sums__note { margin-top: 20px; font-size: 12px; color: var(--graphite); }
  .sums__note a {
    color: var(--silver);
    background: linear-gradient(currentColor, currentColor) left bottom / 100% 1px no-repeat;
  }

  @media (max-width: 760px) {
    .qa { grid-template-columns: 1fr; gap: 10px; }
  }
</style>

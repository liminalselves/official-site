---
// The real Aliya Pet: the app's own Live2D renderer, interactions and lines, built as a web
// embed in the Aliya_pet repo and copied to public/pet/ (scripts/sync-pet-embed.mjs).
// A still image of the same model shows until the embed reports ready, and stays if WebGL
// or loading fails.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['pet-stage', className]} data-pet-stage>
  <img
    class="pet-stage__poster"
    src="/pet-poster/aliya.webp"
    width="765"
    height="1108"
    alt="Aliya Pet 桌宠形象"
    decoding="async"
    fetchpriority="high"
  />
  <iframe
    class="pet-stage__frame"
    title="Aliya Pet 互动形象：点击她，或按住头顶左右滑动抚摸"
    data-src="/pet/embed.html"
  ></iframe>
  <p class="pet-stage__hint"><span class="pet-stage__mouse">点击她，或按住头顶左右滑动</span><span class="pet-stage__touch">轻点她，或在头顶左右滑动</span></p>
</div>

<style>
  .pet-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
  }
  .pet-stage__poster,
  .pet-stage__frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* The model renders with a 1.22 margin around its bounds; match that framing for the poster. */
  .pet-stage__poster {
    object-fit: contain;
    padding: 9% 9% 7%;
    box-sizing: border-box;
    transition: opacity 0.5s var(--ease);
  }
  .pet-stage__frame {
    border: 0;
    background: transparent;
    color-scheme: normal;
    opacity: 0;
    transition: opacity 0.5s var(--ease);
  }
  .pet-stage.is-live .pet-stage__frame { opacity: 1; }
  .pet-stage.is-live .pet-stage__poster { opacity: 0; pointer-events: none; }
  .pet-stage__hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -28px;
    text-align: center;
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--graphite);
    opacity: 0;
    transition: opacity 0.5s var(--ease) 0.4s;
  }
  .pet-stage.is-live .pet-stage__hint { opacity: 1; }
  .pet-stage__touch { display: none; }
  @media (hover: none) and (pointer: coarse) {
    .pet-stage__mouse { display: none; }
    .pet-stage__touch { display: inline; }
  }
</style>

<script>
  // Load the embed only when WebGL2 is available; otherwise keep the poster.
  const hasWebGL2 = (() => {
    try {
      return !!document.createElement('canvas').getContext('webgl2');
    } catch {
      return false;
    }
  })();

  document.querySelectorAll<HTMLElement>('[data-pet-stage]').forEach((stage) => {
    const frame = stage.querySelector<HTMLIFrameElement>('.pet-stage__frame');
    if (!frame || !hasWebGL2) return;
    window.addEventListener('message', (e) => {
      if (e.source !== frame.contentWindow || e.data?.source !== 'aliya-pet') return;
      if (e.data.type === 'ready') stage.classList.add('is-live');
      if (e.data.type === 'error') frame.remove();
    });
    // Mouse moves outside the iframe never reach it; forward them (in the iframe's own
    // coordinates) so Aliya keeps looking at the cursor anywhere on the page.
    let queued = false;
    let last: PointerEvent | null = null;
    document.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse' || !frame.contentWindow) return;
      last = e;
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        if (!last || !frame.contentWindow) return;
        const r = frame.getBoundingClientRect();
        frame.contentWindow.postMessage({ source: 'aliya-pet-host', type: 'look', x: last.clientX - r.left, y: last.clientY - r.top }, location.origin);
      });
    });
    document.documentElement.addEventListener('pointerleave', () => {
      frame.contentWindow?.postMessage({ source: 'aliya-pet-host', type: 'leave' }, location.origin);
    });
    frame.src = frame.dataset.src ?? '';
  });
</script>

---
import { pet } from '../data/pet';
---

<section id="changelog" class="log" aria-labelledby="log-title">
  <div class="wrap">
    <div class="log__head">
      <div>
        <span class="eyebrow" data-reveal>Changelog · 更新日志</span>
        <h2 id="log-title" class="section-title" data-reveal style="--d:1">更新日志</h2>
      </div>
      <a class="log__repo" data-release href={`${pet.repo}/releases`} target="_blank" rel="noopener" data-reveal style="--d:1">
        在 GitHub 查看全部版本<span aria-hidden="true">↗</span>
      </a>
    </div>

    <p class="log__version" data-reveal style="--d:2"><span data-log-version>—</span> · <span data-log-date>—</span></p>

    <div class="log__body" data-notes data-reveal style="--d:3">
      <p>暂无版本信息。</p>
    </div>
  </div>
</section>

<style>
  .log {
    padding: clamp(96px, 13vw, 168px) 0;
    background: linear-gradient(to bottom, var(--ink), var(--ink-2));
  }
  .log__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    flex-wrap: wrap;
  }
  .log__repo {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--silver);
    border-bottom: 1px solid rgba(244, 241, 236, 0.28);
    padding-bottom: 2px;
    transition: color 0.3s, border-color 0.3s;
  }
  .log__repo:hover { color: var(--paper); border-color: var(--paper); }

  .log__version {
    margin-top: 40px;
    font-family: var(--serif);
    font-size: 20px;
    letter-spacing: 0.08em;
    color: var(--paper);
  }
  .log__body {
    max-width: 760px;
    margin-top: 24px;
    font-size: 14px;
    line-height: 2;
    color: rgba(244, 241, 236, 0.72);
  }

  /* Notes HTML is injected at runtime, so these selectors must be global. */
  .log__body :global(h3) {
    margin: 32px 0 4px;
    font-family: var(--serif);
    font-weight: 600;
    font-size: 17px;
    letter-spacing: 0.06em;
    color: var(--paper);
  }
  .log__body :global(h3:first-child) { margin-top: 0; }
  .log__body :global(ul) { margin: 8px 0; }
  .log__body :global(li) { position: relative; padding-left: 18px; }
  .log__body :global(li)::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.9em;
    width: 8px;
    height: 1px;
    background: currentColor;
    opacity: 0.5;
  }
  .log__body :global(code) {
    font-family: Consolas, 'Courier New', monospace;
    font-size: 0.92em;
    padding: 2px 7px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.08);
  }
  .log__body :global(strong) { color: var(--paper); font-weight: 600; }
  .log__body :global(a) {
    color: var(--paper);
    background: linear-gradient(currentColor, currentColor) left bottom / 100% 1px no-repeat;
  }
</style>

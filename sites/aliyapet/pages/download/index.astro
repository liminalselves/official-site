---
import Page from '../../layouts/Page.astro';
import PageHead from '../../components/PageHead.astro';
import DownloadCards from '../../components/DownloadCards.astro';
import { fallbackReleases } from '../../data/changelog-fallback';
import { fmtDateCN } from '../../scripts/api';

const latest = fallbackReleases[0];
---

<Page
  title="下载 · Aliya Pet"
  description="下载 Aliya Pet 最新版本：Windows 安装程序、MSI 安装包与 Android APK，附系统要求与安装说明。"
>
  <PageHead eyebrow="Download · 下载" title="下载">
    <p slot="lead">
      当前版本 <span data-meta-version>{latest.version}</span> · 发布于 <span data-meta-date>{fmtDateCN(latest.publishedAt)}</span> · <a href="/changelog/">查看更新日志</a>
    </p>
  </PageHead>
  <DownloadCards />
</Page>

<script>
  import '../../scripts/download';
</script>

---
import Page from '../layouts/Page.astro';
---

<Page title="页面不存在 · Aliya Pet" description="你访问的页面不存在。" noindex>
  <section class="nf">
    <p class="nf__code serif">404</p>
    <h1 class="nf__title serif">页面不存在</h1>
    <p class="nf__desc">你要访问的页面不存在，可能已经移动或删除。</p>
    <a class="btn btn--solid" href="/"><span>回到首页</span><span class="arrow" aria-hidden="true">→</span></a>
  </section>
</Page>

<style>
  .nf {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    text-align: center;
    padding: 40px 20px;
  }
  .nf__code {
    font-size: clamp(72px, 14vw, 140px);
    line-height: 1;
    letter-spacing: 0.1em;
    color: var(--graphite);
  }
  .nf__title { font-size: clamp(20px, 3vw, 28px); letter-spacing: 0.16em; }
  .nf__desc { font-size: 14px; color: rgba(244, 241, 236, 0.68); }
  .nf .btn { margin-top: 24px; }
</style>

{
  "name": "official-site",
  "version": "1.0.0",
  "private": true,
  "description": "阈界人格项目组官方网站",
  "type": "module",
  "scripts": {
    "start": "node server/index.mjs",
    "build": "astro build && astro build --config astro.aliyapet.config.mjs",
    "serve": "npm run build && npm start",
    "dev": "astro dev",
    "dev:aliyapet": "astro dev --config astro.aliyapet.config.mjs",
    "test": "node --test \"server/test/*.test.mjs\"",
    "assets": "node scripts/gen-assets.mjs",
    "font": "python scripts/subset-font.py"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.1"
  },
  "devDependencies": {
    "@fontsource/noto-serif-sc": "5.3.1"
  }
}

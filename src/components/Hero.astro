---
import { site, links } from '../data/site';
---

<section class="hero" aria-labelledby="hero-title">
  <canvas class="hero__field" data-field aria-hidden="true"></canvas>
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="hero__content wrap" data-parallax>
    <div class="hero__mark">
      <img src="/brand/mark-light.webp" alt="阈界人格标志" width="400" height="335" fetchpriority="high" />
      <span class="hero__sheen" aria-hidden="true"></span>
    </div>

    <h1 id="hero-title" class="hero__title">
      <span class="hero__cn serif">
        <span>阈</span><i aria-hidden="true"></i><span>界</span><i aria-hidden="true"></i><span>人</span><i aria-hidden="true"></i><span>格</span>
      </span>
      <span class="hero__en">Liminal Selves</span>
    </h1>

    <p class="hero__tagline">{site.tagline}</p>

    <div class="hero__actions">
      <a class="btn btn--solid" href={links.community} rel="noopener"><span>进入社区</span><span class="arrow" aria-hidden="true">→</span></a>
      <a class="btn btn--ghost" href="#projects"><span>了解项目</span></a>
    </div>
  </div>

  <a class="hero__scroll" href="#about">
    <span>Scroll<span class="sr-only">：向下了解阈界人格</span></span>
    <i aria-hidden="true"></i>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(60% 50% at 50% 42%, #1b1b1e 0%, rgba(11, 11, 12, 0) 70%),
      var(--ink);
  }
  .hero__field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }

  .hero__glow {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(70vw, 820px);
    aspect-ratio: 1;
    z-index: -1;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(255, 255, 255, 0.08), transparent);
    animation: breathe 9s ease-in-out infinite;
  }
  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 120px 0 140px;
  }

  .hero__mark {
    position: relative;
    width: clamp(120px, 16vw, 188px);
    margin-bottom: 40px;
    animation: rise 1.6s 0.5s var(--ease) both;
    -webkit-mask: url('/brand/mark-light.webp') center / contain no-repeat;
    mask: url('/brand/mark-light.webp') center / contain no-repeat;
  }
  .hero__mark img { width: 100%; height: auto; }
  .hero__sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 35%, rgba(255, 255, 255, 0.95) 50%, transparent 65%);
    background-size: 250% 100%;
    mix-blend-mode: overlay;
    animation: sheen 6s 1.6s ease-in-out infinite;
  }

  .hero__title { display: flex; flex-direction: column; align-items: center; gap: 18px; font-weight: 400; }
  .hero__cn {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2.4vw, 28px);
    font-size: clamp(48px, 9vw, 112px);
    line-height: 1;
    letter-spacing: 0;
  }
  .hero__cn span {
    display: inline-block;
    background: var(--metal);
    background-size: 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: char 1.4s var(--ease) both, metal 8s 2s ease-in-out infinite;
  }
  .hero__cn span:nth-of-type(1) { animation-delay: 0.9s, 2s; }
  .hero__cn span:nth-of-type(2) { animation-delay: 1s, 2.2s; }
  .hero__cn span:nth-of-type(3) { animation-delay: 1.1s, 2.4s; }
  .hero__cn span:nth-of-type(4) { animation-delay: 1.2s, 2.6s; }
  .hero__cn i {
    width: 1px;
    height: 0.62em;
    background: rgba(255, 255, 255, 0.35);
    animation: tick 1s 1.4s var(--ease) both;
  }

  .hero__en {
    display: flex;
    align-items: center;
    gap: 20px;
    font-family: var(--serif);
    font-size: clamp(13px, 1.5vw, 17px);
    letter-spacing: 0.5em;
    padding-left: 0.5em;
    color: var(--silver);
    animation: fade 1.4s 1.5s var(--ease) both;
  }
  .hero__en::before,
  .hero__en::after {
    content: '';
    width: clamp(36px, 8vw, 96px);
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4));
  }
  .hero__en::after { transform: scaleX(-1); }

  .hero__tagline {
    margin-top: 44px;
    font-family: var(--serif);
    font-size: clamp(17px, 2vw, 22px);
    letter-spacing: 0.18em;
    color: rgba(244, 241, 236, 0.86);
    animation: fade 1.4s 1.8s var(--ease) both;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-top: 56px;
    animation: fade 1.4s 2.1s var(--ease) both;
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 32px;
    translate: -50% 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    font-size: 10px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--graphite);
    animation: fade 1s 2.6s both;
  }
  .hero__scroll i {
    position: relative;
    width: 1px;
    height: 48px;
    background: var(--line-dark);
    overflow: hidden;
  }
  .hero__scroll i::after {
    content: '';
    position: absolute;
    left: 0;
    width: 1px;
    height: 40%;
    background: var(--paper);
    animation: drip 2.2s var(--ease) infinite;
  }

  @keyframes breathe {
    50% { transform: scale(1.12); opacity: 0.7; }
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(24px) scale(0.92); filter: blur(10px); }
    to { opacity: 1; transform: none; filter: none; }
  }
  @keyframes sheen {
    0%, 55% { background-position: 150% 0; }
    100% { background-position: -100% 0; }
  }
  @keyframes char {
    from { opacity: 0; transform: translateY(0.4em); filter: blur(12px); }
    to { opacity: 1; transform: none; filter: none; }
  }
  @keyframes metal {
    0%, 100% { background-position: 0% 0; }
    50% { background-position: 100% 0; }
  }
  @keyframes tick {
    from { transform: scaleY(0); }
  }
  @keyframes fade {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes drip {
    from { top: -40%; }
    to { top: 100%; }
  }

  @media (max-width: 520px) {
    .hero__cn i { display: none; }
    .hero__actions .btn { min-width: 150px; }
  }
</style>

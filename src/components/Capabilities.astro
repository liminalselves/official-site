---
import { capabilities, links } from '../data/site';
const marquee = ['Agents', '会话', 'Models', '记忆', 'Images', '主动消息', 'Worldbook', '创作'];
---

<section id="agents" class="caps" aria-labelledby="caps-title">
  <div class="caps__marquee" aria-hidden="true">
    <div class="caps__track">
      {[0, 1].map(() => marquee.map((w) => <span>{w}<i>/</i></span>))}
    </div>
  </div>

  <div class="wrap">
    <div class="caps__head">
      <span class="eyebrow" data-reveal>Agents · 智能体</span>
      <h2 id="caps-title" class="section-title" data-reveal style="--d:1">
        于对话中相遇，<br />于记忆中<span class="metal-text">相知</span>。
      </h2>
      <p class="caps__intro" data-reveal style="--d:2">
        在智能体广场挑选角色开始对话，或者亲手创作一个角色。
      </p>
    </div>

    <ol class="caps__list">
      {capabilities.map((c, i) => (
        <li class="cap" data-reveal style={`--d:${i}`}>
          <span class="cap__no">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="cap__name serif">{c.name}</h3>
          <span class="cap__en">{c.en}</span>
          <p class="cap__desc">{c.desc}</p>
        </li>
      ))}
    </ol>

    <div class="caps__foot" data-reveal>
      <a class="btn btn--ghost" href={`${links.docs}/guide/agent/quick-start`} rel="noopener"><span>智能体游玩入门</span><span class="arrow" aria-hidden="true">→</span></a>
      <a class="btn btn--ghost" href={`${links.docs}/guide/agent/create`} rel="noopener"><span>创作你的角色</span><span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .caps {
    position: relative;
    padding: 0 0 clamp(96px, 13vw, 168px);
    background: var(--ink);
    overflow: hidden;
  }

  .caps__marquee {
    padding: 40px 0;
    border-bottom: 1px solid var(--line-dark);
    overflow: hidden;
    -webkit-mask: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    mask: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .caps__track {
    display: flex;
    width: max-content;
    animation: marquee 40s linear infinite;
  }
  .caps__track span {
    font-family: var(--serif);
    font-size: clamp(40px, 7vw, 96px);
    line-height: 1.1;
    letter-spacing: 0.04em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(244, 241, 236, 0.22);
    white-space: nowrap;
  }
  .caps__track i {
    font-style: normal;
    margin: 0 0.5em;
    -webkit-text-stroke: 0;
    color: rgba(244, 241, 236, 0.18);
  }

  .caps__head { padding-top: clamp(80px, 10vw, 140px); max-width: 760px; }
  .caps__intro { margin-top: 28px; color: rgba(244, 241, 236, 0.66); font-size: 15px; max-width: 560px; }

  .caps__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: clamp(56px, 7vw, 96px) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-dark);
    border-left: 1px solid var(--line-dark);
  }
  .cap {
    position: relative;
    padding: 36px 32px 40px;
    border-right: 1px solid var(--line-dark);
    border-bottom: 1px solid var(--line-dark);
    overflow: hidden;
    isolation: isolate;
    transition: color 0.5s var(--ease);
  }
  .cap::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--paper);
    clip-path: polygon(0 100%, 0 100%, 0 100%);
    transition: clip-path 0.7s var(--ease);
  }
  .cap:hover { color: var(--ink); }
  .cap:hover::before { clip-path: polygon(0 -60%, 160% 100%, 0 100%); }
  .cap:hover .cap__desc, .cap:hover .cap__no, .cap:hover .cap__en { color: #57554f; }
  .cap__no { font-size: 12px; letter-spacing: 0.2em; color: var(--graphite); transition: color 0.5s; }
  .cap__name { margin-top: 36px; font-size: 26px; letter-spacing: 0.1em; }
  .cap__en {
    display: block;
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--graphite);
    transition: color 0.5s;
  }
  .cap__desc { margin-top: 16px; font-size: 14px; color: rgba(244, 241, 236, 0.6); transition: color 0.5s; }

  .caps__foot { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 56px; }

  @keyframes marquee { to { transform: translateX(-50%); } }

  @media (max-width: 860px) {
    .caps__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 520px) {
    .caps__list { grid-template-columns: 1fr; }
    .cap { padding: 28px 24px; }
  }
</style>

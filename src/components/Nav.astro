---
import { links as siteLinks } from '../data/site';

interface NavLink {
  label: string;
  href: string;
  sibling?: string;
  active?: boolean;
}

interface Props {
  brandLabel?: string;
  brandEn?: string;
  brandHref?: string;
  brandSibling?: string;
  brandAria?: string;
  links?: NavLink[];
  cta?: NavLink | null;
  /** Multi-page navigation: keep all links reachable on small screens. */
  paged?: boolean;
}

const {
  brandLabel = '阈界人格',
  brandEn = 'Liminal Selves',
  brandHref = '/',
  brandSibling,
  brandAria = `${brandLabel} 首页`,
  links = [
    { label: '关于', href: '#about' },
    { label: '项目', href: '#projects' },
    { label: '智能体', href: '#agents' },
    { label: '加入', href: '#join' },
    { label: '文档', href: siteLinks.docs },
  ],
  cta = { label: '进入社区', href: siteLinks.community },
  paged = false,
} = Astro.props;

const rel = (href: string) => (/^https?:/.test(href) ? 'noopener' : undefined);
---

<header class:list={['nav', { 'nav--paged': paged }]} data-nav>
  <div class="nav__inner wrap">
    <a class="nav__brand" href={brandHref} data-sibling={brandSibling} aria-label={brandAria}>
      <img src="/brand/mark-light-sm.webp" alt="" width="72" height="60" />
      <span class="serif">{brandLabel}</span>
      {brandEn && <span class="nav__en">{brandEn}</span>}
    </a>
    <nav aria-label="主导航">
      <ul class="nav__links">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              data-sibling={l.sibling}
              rel={rel(l.href)}
              aria-current={l.active ? 'page' : undefined}
            >{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    {cta && (
      <a class="nav__cta" href={cta.href} data-sibling={cta.sibling} rel={rel(cta.href)}>
        {cta.label}
        {/^https?:/.test(cta.href) && <span aria-hidden="true">↗</span>}
      </a>
    )}
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    transition: background 0.5s var(--ease), border-color 0.5s var(--ease), transform 0.5s var(--ease);
    border-bottom: 1px solid transparent;
  }
  .nav.is-scrolled {
    background: rgba(11, 11, 12, 0.72);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-color: var(--line-dark);
  }
  .nav.is-hidden { transform: translateY(-100%); }
  .nav__inner {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 72px;
  }
  .nav__brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 18px;
    letter-spacing: 0.2em;
  }
  .nav__brand img { width: 32px; height: auto; }
  .nav__en {
    font-size: 11px;
    letter-spacing: 0.24em;
    color: var(--graphite);
    padding-left: 12px;
    border-left: 1px solid var(--line-dark);
  }
  .nav nav { margin-left: auto; }
  .nav__links { display: flex; gap: 32px; font-size: 14px; letter-spacing: 0.12em; }
  .nav__links a {
    position: relative;
    color: rgba(244, 241, 236, 0.72);
    transition: color 0.3s;
  }
  .nav__links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.45s var(--ease);
  }
  .nav__links a:hover { color: var(--paper); }
  .nav__links a:hover::after { transform: scaleX(1); transform-origin: left; }
  .nav__links a[aria-current='page'] { color: var(--paper); }
  .nav__links a[aria-current='page']::after { transform: scaleX(1); }
  .nav__cta {
    display: inline-flex;
    gap: 6px;
    padding: 8px 18px;
    font-size: 13px;
    letter-spacing: 0.1em;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 999px;
    transition: background 0.3s, color 0.3s;
  }
  .nav__cta:hover { background: var(--paper); color: var(--ink); }

  @media (max-width: 860px) {
    .nav__en { display: none; }
    /* Single-page sites keep only the first two links on narrow screens. */
    .nav:not(.nav--paged) .nav__links { gap: 18px; }
    .nav:not(.nav--paged) .nav__links li:nth-child(n + 3) { display: none; }
    .nav--paged .nav__inner { gap: 22px; }
    .nav--paged .nav__links { gap: 18px; font-size: 13px; }
  }
  @media (max-width: 640px) {
    .nav--paged .nav__inner {
      flex-wrap: wrap;
      height: auto;
      min-height: 60px;
      padding-block: 10px;
      row-gap: 6px;
    }
    .nav--paged .nav__links {
      order: 3;
      width: 100%;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .nav--paged .nav__links::-webkit-scrollbar { display: none; }
    .nav--paged .nav__cta { margin-left: auto; }
  }
  @media (max-width: 520px) {
    .nav:not(.nav--paged) .nav__inner { gap: 16px; height: 60px; }
    .nav:not(.nav--paged) .nav__links { display: none; }
    .nav:not(.nav--paged) .nav__cta { margin-left: auto; }
  }
</style>

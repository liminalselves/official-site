---
import { site, links, projects } from '../data/site';
const year = new Date().getFullYear();

interface FooterLink {
  label: string;
  href?: string;
  sibling?: string;
}
interface FooterCol {
  heading: string;
  links: FooterLink[];
}
interface Props {
  brandHref?: string;
  brandSibling?: string;
  brandAria?: string;
  cols?: FooterCol[];
}

const {
  brandHref = '/',
  brandSibling,
  brandAria = '阈界人格 首页',
  cols = [
    {
      heading: '项目',
      links: projects.map((p) => ({ label: p.name, href: p.href, sibling: p.sibling })),
    },
    {
      heading: '帮助',
      links: [
        { label: '使用文档', href: links.docs },
        { label: '社区规范', href: links.rules },
        { label: '常见问题', href: links.faq },
      ],
    },
    {
      heading: '联系',
      links: [
        { label: `Q 群 ${site.qqGroup}` },
        { label: site.email, href: `mailto:${site.email}` },
      ],
    },
  ],
} = Astro.props;

const rel = (href?: string) => (href && /^https?:/.test(href) ? 'noopener' : undefined);
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__top">
      <a class="footer__brand" href={brandHref} data-sibling={brandSibling} aria-label={brandAria}>
        <img src="/brand/wordmark-light.webp" alt="阈界人格 Liminal Selves" width="440" height="118" loading="lazy" />
      </a>
      <nav class="footer__cols" aria-label="页脚导航">
        {cols.map((col) => (
          <div>
            <h2 class="footer__h">{col.heading}</h2>
            <ul>
              {col.links.map((l) => (
                <li>
                  {l.href ? (
                    <a href={l.href} data-sibling={l.sibling} rel={rel(l.href)}>{l.label}</a>
                  ) : (
                    <span>{l.label}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>
    <div class="footer__bottom">
      <span class="footer__copy">© {year} 阈界人格 Liminal Selves</span>
      <a class="footer__icp" href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">{site.icp}</a>
      <span class="footer__motto">在边界之间，连接不同的自我。</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 80px 0 36px;
    background: var(--ink);
    border-top: 1px solid var(--line-dark);
    font-size: 14px;
  }
  .footer__top {
    display: flex;
    justify-content: space-between;
    gap: 56px;
    flex-wrap: wrap;
  }
  .footer__brand img { width: 220px; height: auto; opacity: 0.9; }
  .footer__cols { display: flex; gap: clamp(40px, 7vw, 96px); flex-wrap: wrap; }
  .footer__h {
    margin-bottom: 16px;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.24em;
    color: var(--graphite);
  }
  .footer__cols li { margin-top: 8px; color: rgba(244, 241, 236, 0.72); }
  .footer__cols a { transition: color 0.3s; }
  .footer__cols a:hover { color: var(--paper); }
  /* Equal side columns keep the record number at the exact centre */
  .footer__bottom {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 12px 24px;
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--line-dark);
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--graphite);
  }
  .footer__copy { text-align: left; }
  .footer__icp { text-align: center; letter-spacing: 0.06em; transition: color 0.3s; }
  .footer__icp:hover { color: var(--paper); }
  .footer__motto { text-align: right; font-family: var(--serif); letter-spacing: 0.2em; }

  @media (max-width: 760px) {
    .footer__bottom { grid-template-columns: 1fr; }
    .footer__copy, .footer__icp, .footer__motto { text-align: center; }
  }
</style>

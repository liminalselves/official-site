---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title="页面不存在 · 阈界人格" description="你访问的页面不存在。" noindex>
  <main id="main" class="nf">
    <img src="/brand/mark-light.webp" alt="" width="400" height="335" />
    <p class="nf__code serif">404</p>
    <h1 class="nf__title serif">这道门后什么也没有</h1>
    <a class="btn btn--solid" href="/"><span>回到首页</span><span class="arrow" aria-hidden="true">→</span></a>
  </main>
  <p class="nf__icp">
    <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">{site.icp}</a>
  </p>
</Base>

<style>
  .nf {
    min-height: calc(100svh - 56px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    text-align: center;
    padding: 40px 20px;
  }
  .nf img { width: 96px; height: auto; opacity: 0.85; }
  .nf__code { font-size: clamp(72px, 14vw, 140px); line-height: 1; letter-spacing: 0.1em; color: var(--graphite); }
  .nf__title { font-size: clamp(20px, 3vw, 28px); letter-spacing: 0.16em; margin-bottom: 20px; }
  .nf__icp { padding: 0 0 24px; text-align: center; font-size: 12px; letter-spacing: 0.06em; }
  .nf__icp a { color: var(--graphite); }
  .nf__icp a:hover { color: var(--paper); }
</style>
